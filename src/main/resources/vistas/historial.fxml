<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ControladorHistorial" alignment="CENTER" spacing="12.0"
      prefWidth="400.0" prefHeight="330.0">
    <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0" /></padding>
    <children>
        <Label fx:id="paso" text="Jugada 0" />
        <GridPane alignment="CENTER">
            <children>
                <Label fx:id="ficha0" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="ficha1" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="ficha2" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label fx:id="ficha3" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="ficha4" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="ficha5" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="ficha6" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="ficha7" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label fx:id="ficha8" alignment="CENTER" prefWidth="80.0" prefHeight="70.0" style="-fx-font-size: 36; -fx-border-color: gray;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="anterior" text="Anterior" onAction="#anterior" />
                <Button fx:id="siguiente" text="Siguiente" onAction="#siguiente" />
                <Button text="Guardar TXT" onAction="#guardar" />
            </children>
        </HBox>
    </children>
</VBox>
